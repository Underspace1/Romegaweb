romega.online, www.romega.online {
	root * /var/www/romega.online
	encode zstd gzip

	handle /admin/api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /admin* {
		header {
			Cache-Control "no-store"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
		}
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle {
		@feed path /annonces.json
		rewrite @feed /data/annonces.json
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
